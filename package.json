{
  "name": "light-novel",
  "private": true,
  "description": "中日文小说互译生产流水线治理仓库",
  "scripts": {
    "agent:status": "python3 scripts/agent.py status",
    "agent:next": "python3 scripts/agent.py next",
    "agent:queue": "python3 scripts/agent.py queue",
    "agent:real-api": "python3 scripts/run_real_api_smoke.py",
    "agent:real-api:real": "python3 scripts/run_real_api_smoke.py --real",
    "agent:browser": "python3 scripts/run_browser_inspection.py",
    "check:cursor-mcp": "bash scripts/check_cursor_mcp_status.sh",
    "check:mcp": "node scripts/check_mcp_config.js",
    "check:stitch": "node scripts/check_stitch_config.js",
    "check:tooling": "sh scripts/run_tooling_checks.sh",
    "git:cohort:preflight": "python3 scripts/git_safe_cohort_finalizer.py preflight",
    "git:cohort:finalize": "python3 scripts/git_safe_cohort_finalizer.py finalize",
    "git:cohort:retry": "python3 scripts/git_safe_cohort_finalizer.py retry-push",
    "git:cohort:verify": "python3 scripts/git_safe_cohort_finalizer.py verify",
    "dev:frontend": "python3 scripts/serve_frontend.py --port 5174",
    "test:py": "sh scripts/run_python_tests.sh",
    "test:ui": "playwright test",
    "test:ui:headed": "playwright test --headed"
  },
  "devDependencies": {
    "@google/stitch-sdk": "^0.3.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@playwright/test": "^1.60.0"
  }
}
