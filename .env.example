# .env.example - variable names only. Do NOT commit real values.
# Copy to .env and fill non-empty values: cp .env.example .env

# --- Production real API (required for resume / pilot_batch_chain) ---
# OPENROUTER_API_KEY must be NON-EMPTY. A blank line like OPENROUTER_API_KEY=
# is treated as unset and will report missing_api_key.
OPENROUTER_API_KEY=your_openrouter_key_here
REAL_API_TESTS_ENABLED=true
# Production translate/refine budget per process (USD). Use >= 2.0 for batch resume.
MAX_TEST_COST_USD=2.0
# Optional separate cap for translate batches in pilot_batch_chain.sh
# TRANSLATE_MAX_TEST_COST_USD=2.5
CONTROLLED_RUN_ENABLED=true

# --- Model Router ---
MODEL_ROUTER_DEFAULT_PROFILE=coding
# MODEL_ROUTER_CONFIG_PATH=model-router/config/models.yaml

# Other provider keys (optional; OpenRouter is the production default)
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
GROK_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DOMESTIC_RELAY_API_KEY=

# Token / cost guards
# MAX_TOKENS_PER_RUN=0 means unlimited; set a positive integer to hard-stop by token estimate
MAX_TOKENS_PER_RUN=0
COST_PER_MILLION_TOKENS=0.5
CONTROLLED_RUN_ID=default

# Draft translation model (OpenRouter slug)
DRAFT_MODEL=deepseek/deepseek-v4-pro
REFINE_MODEL=x-ai/grok-4.3

# --- Stitch Design MCP (UI prototypes; never commit real key) ---
STITCH_API_KEY=your_stitch_api_key_here

# Quick checks after editing .env:
#   python3 scripts/run_real_api_smoke.py --status-only --json
#   python3 scripts/throughput_gate.py --json
# Production resume (+20 chapters from ch.151):
#   python3 scripts/resume_production.py --run-id run_20260605_111734_draft_stage_b_50ch \
#     --chapter-offset 150 --target-new-chapters 20 --hydrate-apply
