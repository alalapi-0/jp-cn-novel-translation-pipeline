# .env.example - variable names only. Do NOT commit real values.

# --- Model Router ---
# Default profile when model_router.chat(..., profile=None) (see model-router/config/models.yaml)
MODEL_ROUTER_DEFAULT_PROFILE=coding
# Optional override path to models.yaml
# MODEL_ROUTER_CONFIG_PATH=model-router/config/models.yaml

# Provider API keys (read from environment only; never commit)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
GROK_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Domestic OpenAI-compatible relay (configure base_url in models.yaml)
DOMESTIC_RELAY_API_KEY=

# Cost guard (defaults: no real API, zero budget)
# REAL_API_TESTS_ENABLED=false blocks outbound real provider calls
REAL_API_TESTS_ENABLED=false
# MAX_TEST_COST_USD=0 blocks Workbench page real-api-generate (button stays disabled).
# Set >0 (e.g. 0.01) for page small-sample real API; smoke script uses the same guard.
MAX_TEST_COST_USD=0
# MAX_TOKENS_PER_RUN=0 means unlimited; set a positive integer to hard-stop by token estimate
MAX_TOKENS_PER_RUN=0
# COST_PER_MILLION_TOKENS used for dry-run cost estimation only
COST_PER_MILLION_TOKENS=0.5

# Controlled run (Round 50+ real trial requires explicit enable + user authorization)
CONTROLLED_RUN_ENABLED=false
CONTROLLED_RUN_ID=default

# Draft translation model (OpenRouter slug)
DRAFT_MODEL=deepseek/deepseek-v4-pro
# Refine model — do not use until baseline draft exists
REFINE_MODEL=x-ai/grok-4.3

# --- Stitch Design MCP (UI prototypes; never commit real key) ---
STITCH_API_KEY=your_stitch_api_key_here
