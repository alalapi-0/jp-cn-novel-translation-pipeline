{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "light_novel/schemas/character_profile.schema.json",
  "title": "Character Profile (spec §7.9)",
  "description": "角色设定 schema。模板 configs/character_profile.yaml；真实数据 workspace/configs/character_profile.yaml。",
  "type": "object",
  "required": [
    "schema_version",
    "characters"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "meta": {
      "type": "object",
      "additionalProperties": true
    },
    "characters": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/character"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "character": {
      "type": "object",
      "required": [
        "name",
        "target_name",
        "aliases",
        "address_map",
        "first_person",
        "speech_tics",
        "honorific_style",
        "personality_summary",
        "speech_style",
        "forbidden",
        "appearing_chapters",
        "relationships",
        "manual_notes",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "target_name": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "address_map": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "to",
              "address"
            ],
            "properties": {
              "to": {
                "type": "string",
                "minLength": 1
              },
              "address": {
                "type": "string",
                "minLength": 1
              },
              "context": {
                "type": "string"
              },
              "knowledge_claims": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/knowledge_claim"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "first_person": {
          "type": [
            "string",
            "null"
          ]
        },
        "speech_tics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "honorific_style": {
          "type": [
            "string",
            "null"
          ]
        },
        "personality_summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "speech_style": {
          "type": [
            "string",
            "null"
          ]
        },
        "forbidden": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "appearing_chapters": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "character",
              "relation"
            ],
            "properties": {
              "character": {
                "type": "string",
                "minLength": 1
              },
              "relation": {
                "type": "string",
                "minLength": 1
              },
              "knowledge_claims": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/knowledge_claim"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "manual_notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": "string",
          "minLength": 1
        },
        "updated_at": {
          "type": "string",
          "minLength": 1
        },
        "knowledge_claims": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/knowledge_claim"
          }
        }
      },
      "additionalProperties": true
    },
    "knowledge_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "category",
        "statement"
      ],
      "properties": {
        "schema": {
          "const": "knowledge-claim/1"
        },
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "glossary",
            "character",
            "world",
            "summary",
            "relationship",
            "address",
            "creative_pattern",
            "unknown"
          ]
        },
        "statement": {
          "type": "string"
        },
        "epistemic_status": {
          "enum": [
            "assertion",
            "inference",
            "unknown"
          ]
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "producer": {
          "enum": [
            "model",
            "rule",
            "import",
            "owner",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_catalog_sha256",
              "chapter_id",
              "segment_id",
              "source_sha256",
              "start_char",
              "end_char",
              "quote"
            ],
            "properties": {
              "source_catalog_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "chapter_id": {
                "type": "string",
                "minLength": 1
              },
              "segment_id": {
                "type": "string",
                "minLength": 1
              },
              "source_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "start_char": {
                "type": "integer",
                "minimum": 0
              },
              "end_char": {
                "type": "integer",
                "minimum": 1
              },
              "quote": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "effective_from": {
          "type": [
            "string",
            "null"
          ]
        },
        "effective_until": {
          "type": [
            "string",
            "null"
          ]
        },
        "subject_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "object_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "predicate": {
          "type": [
            "string",
            "null"
          ]
        },
        "speaker_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "slot": {
          "type": [
            "string",
            "null"
          ]
        },
        "alternatives": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target",
              "condition"
            ],
            "properties": {
              "target": {
                "type": "string",
                "minLength": 1
              },
              "condition": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "withdrawn": {
          "type": "boolean"
        },
        "semantic_truth": {
          "const": "not_verified"
        }
      }
    }
  }
}
